{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "high-res",
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "high-res"
    }
  ],
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "high-res-media"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "SESSION",
      "id": "1ff71bffbbe145929c474c859f53552a"
    }
  ],
  "images": { "binding": "IMAGES" },
  "triggers": {
    "crons": ["* * * * *"]
  }
}

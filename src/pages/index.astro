---
import { getEmDashCollection } from "emdash";
import seed from "../../seed/seed.json";
import PhotoFeed from "../components/PhotoFeed.astro";
import Base from "../layouts/Base.astro";

const { entries: photos, cacheHint } = await getEmDashCollection("photos", {
  status: "published",
  limit: 100,
  orderBy: { sort_order: "asc" },
});
if (Astro.cache?.enabled) Astro.cache.set(cacheHint);

// The public journal remains complete before its first CMS setup. Once the
// setup wizard imports this same seed, live EmDash records take precedence.
const feedPhotos = photos.length
  ? photos
  : seed.content.photos.map((photo) => ({ data: photo.data, edit: {} }));
---

<Base title="Tech Tarik" description="A personal photo journal">
  <PhotoFeed photos={feedPhotos} />
</Base>
